{
  "name": "bb-miping-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-start.ps1",
    "dev:raw": "concurrently -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-stop.ps1",
    "dev:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-status.ps1",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

